---
import Layout from '~/layouts/PageLayout.astro';

import { Icon } from 'astro-icon/components';

import Header from '~/components/widgets/Header.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Announcement from '~/components/widgets/Announcement.astro';
import Content from '~/components/widgets/Content.astro';
import Steps from '~/components/widgets/Steps.astro';
import SkillsChips from '~/components/widgets/SkillsChips.astro';
import ContactForm from '~/components/widgets/ContactForm.astro';

const metadata = {
  title: 'Mostafa Shirvani — DevOps / Cloud Engineer',
  description:
    'Early DevOps hire at an Italian startup. Platform migration, security incident response, and vendor strategy. Career switcher from Mining Engineering.',
};
---

<Layout metadata={metadata}>
  <Fragment slot="announcement">
    <Announcement />
  </Fragment>
  <Fragment slot="header">
    <Header
      links={[
        { text: 'About', href: '#about' },
        { text: 'Experience', href: '#experience' },
        { text: 'Education', href: '#education' },
        { text: 'Skills', href: '#skills' },
        { text: 'Projects', href: '#projects' },
        { text: 'GitHub', href: 'https://github.com/Soheil7799' },
      ]}
      actions={[
        {
          text: 'Get in touch',
          href: '#contact',
        },
      ]}
      isSticky
      showToggleTheme
      position="right"
    />
  </Fragment>

  <!-- Hero ********************************************************* -->
  <Hero2
    id="hero"
    title="Mostafa Shirvani"
    tagline="DevOps / Cloud Engineer · Torino, Italy"
    actions={[
      { variant: 'primary', text: 'Download CV', href: '/Mostafa-Shirvani_CV.pdf', target: '_blank' },
      { text: 'Get in touch', href: '#contact' },
    ]}
  >
    <Fragment slot="subtitle">
      First DevOps hire at an Italian startup. Platform migrations, security incident response,
      vendor strategy. Career switcher from Mining Engineering — composure under pressure included.
    </Fragment>
    <Fragment slot="image">
      <div class="mx-auto lg:mx-0 lg:ml-auto w-full max-w-md">
        <div class="rounded-lg border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 shadow-xl overflow-hidden">
          <div class="flex items-center gap-1.5 px-3 py-2 border-b border-slate-300 dark:border-slate-700 bg-slate-200 dark:bg-slate-800">
            <span class="w-3 h-3 rounded-full bg-red-400/80"></span>
            <span class="w-3 h-3 rounded-full bg-yellow-400/80"></span>
            <span class="w-3 h-3 rounded-full bg-green-400/80"></span>
            <span class="text-xs font-mono text-slate-500 dark:text-slate-400 ml-2">~/mostafa@torino</span>
          </div>
          <pre class="p-4 font-mono text-sm text-slate-700 dark:text-slate-200 leading-relaxed whitespace-pre-wrap m-0"><span class="text-amber-600 dark:text-amber-400">$</span> whoami
devops-engineer
<span class="text-amber-600 dark:text-amber-400">$</span> cat stack.txt
python · go · aws · akamai · docker
terraform · postgres · k8s (learning)
<span class="text-amber-600 dark:text-amber-400">$</span> uptime
11 months at StarView, 0 prod fires
<span class="text-amber-600 dark:text-amber-400">$</span> open --to-recruiters
<span class="inline-block w-2 h-4 bg-slate-700 dark:bg-slate-200 align-middle animate-pulse"></span></pre>
        </div>
      </div>
    </Fragment>
  </Hero2>

  <!-- About ******************************************************** -->
  <Content
    id="about"
    image={{
      src: '/avatar.png',
      alt: 'Mostafa Shirvani',
      loading: 'eager',
      class: 'mx-auto rounded-full bg-gray-500 shadow-lg w-72 h-72 sm:w-80 sm:h-80 object-cover',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">About me</h2>
      <p>
        I'm a DevOps engineer in Torino, Italy, working at a B2B damage assessment startup
        (DisasterLens) where I joined as the first dedicated DevOps hire. I own everything from
        infrastructure migrations to security incident response to vendor partnerships — small
        startup, big surface area.
      </p>
      <br />
      <p>
        I came into tech from Mining Engineering. I finished my first degree at the University of
        Tehran in early 2022 and moved to Italy to start Computer Engineering at Politecnico di
        Torino. Years of demanding fieldwork taught me to keep my head when systems break and
        customers are looking — something that paid off twice when our platform was attacked (once
        successfully, once not, thanks to architecture that learned its lesson).
      </p>
      <br />
      <p>
        Earlier this year I co-taught a 3-month application development bootcamp. In my spare time
        I'm learning Rust, running NixOS on my own machine, and tinkering with infrastructure for
        the fun of it.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="https://github.com/Soheil7799"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-200 hover:border-amber-500 dark:hover:border-amber-400 hover:bg-amber-50 dark:hover:bg-amber-500/10 hover:text-amber-700 dark:hover:text-amber-300 hover:-translate-y-0.5 hover:shadow-md transition-all duration-200"
        >
          <Icon name="tabler:brand-github" class="w-5 h-5" />
          <span class="font-medium">GitHub</span>
        </a>
        <a
          href="https://www.linkedin.com/in/mostafa-shirvani/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-200 hover:border-amber-500 dark:hover:border-amber-400 hover:bg-amber-50 dark:hover:bg-amber-500/10 hover:text-amber-700 dark:hover:text-amber-300 hover:-translate-y-0.5 hover:shadow-md transition-all duration-200"
        >
          <Icon name="tabler:brand-linkedin" class="w-5 h-5" />
          <span class="font-medium">LinkedIn</span>
        </a>
        <a
          href="mailto:MostafaShirvani1999@gmail.com"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-200 hover:border-amber-500 dark:hover:border-amber-400 hover:bg-amber-50 dark:hover:bg-amber-500/10 hover:text-amber-700 dark:hover:text-amber-300 hover:-translate-y-0.5 hover:shadow-md transition-all duration-200"
        >
          <Icon name="tabler:mail" class="w-5 h-5" />
          <span class="font-medium">Email</span>
        </a>
        <a
          href="/Mostafa-Shirvani_CV.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-amber-500 dark:border-amber-400 bg-amber-50 dark:bg-amber-500/10 text-amber-700 dark:text-amber-300 hover:bg-amber-100 dark:hover:bg-amber-500/20 hover:-translate-y-0.5 hover:shadow-md transition-all duration-200"
        >
          <Icon name="tabler:file-download" class="w-5 h-5" />
          <span class="font-medium">CV (PDF)</span>
        </a>
      </div>
    </Fragment>
  </Content>

  <!-- Work Experience ********************************************** -->
  <Steps
    id="experience"
    title="Work experience"
    items={[
      {
        title:
          'DevOps / Cloud Engineer <br /> <span class="font-normal">StarView (Early DevOps Hire) — B2B Damage Assessment Platform · Torino, Italy</span> <br /> <span class="text-sm font-normal">Jun. 2025 - Present</span>',
        description: `Migrated DisasterLens (V1 → V2) from a legacy EC2 monolith to a cloud-agnostic Akamai (Linode) static-CDN deployment with Terraform + Ansible — 9× faster builds (8m → 55s), ~25% faster DB queries, and near-zero hosting cost.
        <br /><br />
        Led incident response to a production breach via Next.js "React2Shell" (CVE-2025-55182, Dec. 2025) — removed the injected cryptominer mid-customer-engagement, rebuilt the server, and re-architected with Docker service isolation. The next exploit attempt was contained automatically — remediation took only a software update.
        <br /><br />
        Designed an event-driven ML pipeline in Docker Compose + RabbitMQ, cutting manual operations by 90%. Built a Private Cloud with SSO via Keycloak securing 4 self-hosted services. Represented StarView at industry events (Corley &amp; AWS Italy, Akamai partner meetings) — sourced $15k+ in service credits. Mentored 3 backend developers on Serverless patterns.`,
        icon: 'tabler:server-cog',
      },
      {
        title:
          'Backend &amp; DevOps Instructor <br /> <span class="font-normal">Application Development Lifecycle Bootcamp · Torino, Italy</span> <br /> <span class="text-sm font-normal">Mar. 2026 - May 2026</span>',
        description: `Co-organized a 3-month full-stack development bootcamp preparing 5 intern/junior candidates for entry-level positions. Taught backend (FastAPI + SQLAlchemy + Pydantic, PostgreSQL), DevOps fundamentals (Docker, GitLab CI/CD, Linux + Git), and the full application development lifecycle.
        <br /><br />
        Built an interactive <strong>Git workshop tool</strong> — a Python CLI/TUI that scaffolds 24 hands-on exercises across 5 parts (foundational ops, history navigation, branching/merging, distributed workflows, history modification). Used in the bootcamp; published openly on GitHub.
        <br /><br />
        <a href="https://github.com/Soheil7799/workshop-git" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md border border-amber-500/40 dark:border-amber-400/40 bg-amber-50 dark:bg-amber-500/10 text-amber-700 dark:text-amber-300 font-semibold hover:bg-amber-100 dark:hover:bg-amber-500/20 hover:border-amber-500 dark:hover:border-amber-400 transition-colors text-sm">Open the workshop on GitHub <span aria-hidden="true">→</span></a>`,
        icon: 'tabler:school',
      },
    ]}
    classes={{ container: 'max-w-3xl' }}
  />

  <!-- Education **************************************************** -->
  <Steps
    id="education"
    title="Education"
    items={[
      {
        title:
          'B.Sc. Computer Engineering <br /> <span class="font-normal">Politecnico di Torino</span> <br /> <span class="text-sm font-normal">Oct. 2022 - Jun. 2027 (Expected)</span>',
        description: `30L/30 (with honors) in Cybersecurity and National Defence · 30/30 in Music and Multimedia Streaming (the course behind my MECAS project). Coursework: Operating Systems, Computer Networks, Databases, Algorithms, OOP, Computer Architecture.`,
        icon: 'tabler:school',
      },
      {
        title:
          'B.Sc. Mining Engineering <br /> <span class="font-normal">University of Tehran</span> <br /> <span class="text-sm font-normal">Oct. 2017 - Jan. 2022</span>',
        description: `Field internships across demanding mining operations. Learned stakeholder negotiation and composure under pressure that I now apply to production-incident response.`,
        icon: 'tabler:school',
      },
    ]}
    classes={{ container: 'max-w-3xl' }}
  />

  <!-- Skills ******************************************************* -->
  <SkillsChips
    id="skills"
    title="Technical Skills"
    subtitle="What I use day-to-day. Each item is something I can speak to in interview detail."
    groups={[
      {
