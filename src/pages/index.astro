        items: [
          'PostgreSQL',
          'Redis',
          'MinIO',
          'S3',
          'R2',
          'RabbitMQ',
          'Supabase',
          'HashiCorp Vault',
          'Keycloak',
          'OpenID Connect',
        ],
      },
      {
        label: 'Tools, Systems & Architecture',
        items: ['Git', 'REST', 'Linux', 'NixOS', 'Bash', 'Microservices', 'Serverless', 'Agile/Scrum'],
      },
      {
        label: 'Currently learning',
        items: ['Rust', 'Kubernetes (CKA)', 'Kafka', 'Azure', 'AI/ML', 'WASM'],
      },
    ]}
  />

  <!-- Projects ***************************************************** -->
  <Content
    id="projects"
    title="Selected Projects"
    subtitle="A mix of academic-final-project depth and side-project breadth."
    isReversed
    items={[
      {
        title: 'Stack:',
        description: 'FastAPI · SciPy + NumPy DSP · FFmpeg · Docker Compose · GitHub Actions → AWS',
      },
      {
        title: 'Highlights:',
        description:
          'Modular layout across 4 packages (api, filters, formatings, frontend) with browser drag-and-drop and real-time filter parameter control. Final project for the Music and Multimedia Streaming course (graded 30/30).',
      },
    ]}
    image={{
      src: '/projects/mecas.svg',
      alt: 'MECAS architecture diagram',
      width: 900,
      height: 600,
    }}
    callToAction={{
      target: '_blank',
      text: 'View on GitHub',
      icon: 'tabler:chevron-right',
      href: 'https://github.com/Soheil7799/mecas-service',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        MECAS — Media Conversion &amp; Streaming Service
      </h3>
      <p>
        FastAPI service for audio/video processing — SciPy + NumPy audio DSP (gain compression,
        voice enhancement, noise reduction) and FFmpeg video pipelines (grayscale, color inversion,
        frame interpolation, upscaling) across MP4/AVI/MOV up to 200MB.
      </p>
    </Fragment>
  </Content>

  <!-- Compact 2-up grid for smaller side projects ------------------- -->
  <section class="px-4 pb-16 sm:px-6 mx-auto max-w-6xl">
    <div class="grid md:grid-cols-2 gap-6">
      <a
        href="https://github.com/Soheil7799/go-server-tools"
        target="_blank"
        rel="noopener noreferrer"
        class="block group rounded-lg border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 p-6 hover:border-amber-500 dark:hover:border-amber-400 transition-colors"
      >
        <h3
          class="text-lg font-bold text-slate-900 dark:text-slate-100 mb-2 group-hover:text-amber-700 dark:group-hover:text-amber-400 transition-colors"
        >
          Go Server Management Tool
        </h3>
        <p class="font-mono text-xs text-slate-500 dark:text-slate-400 mb-3">
          Go · Bubble Tea TUI · YAML config · ssh / rsync
        </p>
        <p class="text-sm text-slate-700 dark:text-slate-300 mb-4">
          CLI with a TUI for picking servers and SSH keys from a YAML config, then dispatching ssh
          and rsync commands. Clean <code class="text-xs">cmd/internal</code> layout. Built to
          scratch my own itch managing multiple servers.
        </p>
        <span class="text-sm text-amber-700 dark:text-amber-400 font-medium">View on GitHub →</span>
      </a>

      <a
        href="https://github.com/Soheil7799/snippetbox"
        target="_blank"
        rel="noopener noreferrer"
        class="block group rounded-lg border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 p-6 hover:border-amber-500 dark:hover:border-amber-400 transition-colors"
      >
        <h3
          class="text-lg font-bold text-slate-900 dark:text-slate-100 mb-2 group-hover:text-amber-700 dark:group-hover:text-amber-400 transition-colors"
        >
          SnippetBox Web App
        </h3>
        <p class="font-mono text-xs text-slate-500 dark:text-slate-400 mb-3">
          Go · net/http · SCS · bcrypt · PostgreSQL
        </p>
        <p class="text-sm text-slate-700 dark:text-slate-300 mb-4">
          Full-stack Go web app following Alex Edwards&apos;s <em>Let&apos;s Go</em> book. A
          hands-on intro to Go&apos;s web stack and security patterns (CSRF protection, secure
          headers, session management).
        </p>
        <span class="text-sm text-amber-700 dark:text-amber-400 font-medium">View on GitHub →</span>
      </a>
    </div>
  </section>

  <!-- Contact / CTA ************************************************ -->
  <ContactForm
    id="contact"
    title="Let's build something"
    subtitle="Open to DevOps / Cloud Engineering roles in the EU. Drop a message below or email me directly."
    endpoint="https://formspree.io/f/xjkwdzbq"
    emailFallback="MostafaShirvani1999@gmail.com"
  />

  <script>
    // Active section indicator: highlight the nav link for whichever section is
    // currently in the upper portion of the viewport.
    const sections = document.querySelectorAll<HTMLElement>('[id="about"], [id="experience"], [id="education"], [id="skills"], [id="projects"], [id="contact"]');
    const navLinks = document.querySelectorAll<HTMLAnchorElement>('header nav a[href^="#"]');

    const linkMap = new Map<string, HTMLAnchorElement>();
    navLinks.forEach((link) => {
      const href = link.getAttribute('href');
      if (href && href.startsWith('#')) {
        linkMap.set(href.substring(1), link);
      }
    });

    const ACTIVE_CLASSES = ['text-accent', 'font-bold'];

    const clearActive = () => {
      linkMap.forEach((link) => link.classList.remove(...ACTIVE_CLASSES));
    };

    if (sections.length && linkMap.size) {
      const observer = new IntersectionObserver(
        (entries) => {
          // Pick the visible entry with the largest intersection ratio
          const visible = entries.filter((e) => e.isIntersecting);
          if (visible.length === 0) return;
          const best = visible.reduce((a, b) =>
            a.intersectionRatio > b.intersectionRatio ? a : b
          );
          const id = (best.target as HTMLElement).id;
          const link = linkMap.get(id);
          if (link) {
            clearActive();
            link.classList.add(...ACTIVE_CLASSES);
          }
        },
        {
          // Section must be in the upper-middle band of the viewport
          rootMargin: '-30% 0px -55% 0px',
          threshold: [0, 0.25, 0.5, 0.75, 1],
        }
      );

      sections.forEach((s) => observer.observe(s));
    }
  </script>
</Layout>
</Layout>
