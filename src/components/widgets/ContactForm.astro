---
interface Props {
  id?: string;
  title?: string;
  subtitle?: string;
  endpoint: string;
  emailFallback?: string;
}

const { id, title, subtitle, endpoint, emailFallback = 'MostafaShirvani1999@gmail.com' } = Astro.props;
---

<section id={id} class="px-4 py-16 sm:px-6 lg:py-20 mx-auto max-w-3xl">
  {
    (title || subtitle) && (
      <div class="mb-10 text-center">
        {title && (
          <h2 class="text-3xl md:text-4xl font-bold leading-tighter tracking-tighter font-heading mb-4 dark:text-white">
            {title}
          </h2>
        )}
        {subtitle && <p class="text-xl text-muted dark:text-slate-300">{subtitle}</p>}
      </div>
    )
  }

  <form
    id="contact-form"
    action={endpoint}
    method="POST"
    class="flex flex-col gap-4 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 p-6 sm:p-8 shadow-lg"
  >
    <div>
      <label for="email" class="block text-sm font-medium mb-2 dark:text-slate-200">Your email</label>
      <input
        type="email"
        name="email"
        id="email"
        required
        placeholder="your@email.com"
        class="w-full px-4 py-3 rounded-lg border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:ring-2 focus:ring-amber-500 focus:outline-none transition"
      />
    </div>
    <div>
      <label for="subject" class="block text-sm font-medium mb-2 dark:text-slate-200">Subject (optional)</label>
      <input
        type="text"
        name="subject"
        id="subject"
        placeholder="Job opportunity / question / collaboration"
        class="w-full px-4 py-3 rounded-lg border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:ring-2 focus:ring-amber-500 focus:outline-none transition"
      />
    </div>
    <div>
      <label for="message" class="block text-sm font-medium mb-2 dark:text-slate-200">Message</label>
      <textarea
        name="message"
        id="message"
        rows="5"
        required
        placeholder="Tell me about the role or project..."
        class="w-full px-4 py-3 rounded-lg border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:ring-2 focus:ring-amber-500 focus:outline-none resize-vertical transition"
      ></textarea>
    </div>

    <div
      id="contact-status-success"
      class="hidden p-3 rounded-lg bg-green-100 dark:bg-green-900/30 border border-green-300 dark:border-green-700 text-green-800 dark:text-green-200"
    >
      Message sent. I'll get back to you soon.
    </div>
    <div
      id="contact-status-error"
      class="hidden p-3 rounded-lg bg-red-100 dark:bg-red-900/30 border border-red-300 dark:border-red-700 text-red-800 dark:text-red-200"
    >
      Could not send. Email me directly at <a href={`mailto:${emailFallback}`} class="underline">{emailFallback}</a>.
    </div>

    <button
      type="submit"
      id="contact-submit"
      class="mt-2 px-6 py-3 rounded-lg font-semibold bg-amber-600 hover:bg-amber-700 dark:bg-amber-500 dark:hover:bg-amber-400 text-white dark:text-slate-900 transition-colors disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
    >
      Send message
    </button>
  </form>

  <p class="text-center text-sm text-slate-500 dark:text-slate-400 mt-4">
    Or email me directly: <a href={`mailto:${emailFallback}`} class="text-amber-700 dark:text-amber-400 underline">{emailFallback}</a>
  </p>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submit = document.getElementById('contact-submit') as HTMLButtonElement | null;
  const success = document.getElementById('contact-status-success');
  const error = document.getElementById('contact-status-error');

  if (form && submit && success && error) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      success.classList.add('hidden');
      error.classList.add('hidden');
      submit.disabled = true;
      const originalText = submit.textContent;
      submit.textContent = 'Sending...';

      try {
        const formData = new FormData(form);
        const response = await fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: { Accept: 'application/json' },
        });
        if (response.ok) {
          success.classList.remove('hidden');
          form.reset();
        } else {
          error.classList.remove('hidden');
        }
      } catch {
        error.classList.remove('hidden');
      } finally {
        submit.disabled = false;
        submit.textContent = originalText;
      }
    });
  }
</script>
