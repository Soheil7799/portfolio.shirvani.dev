---
import '@fontsource-variable/inter';

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---

<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: rgb(15 23 42);       /* slate-900 */
    --aw-color-secondary: rgb(51 65 85);     /* slate-700 */
    --aw-color-accent: rgb(217 119 6);       /* amber-600 */

    --aw-color-text-heading: rgb(15 23 42);
    --aw-color-text-default: rgb(30 41 59);  /* slate-800 */
    --aw-color-text-muted: rgb(71 85 105);   /* slate-600 */
    --aw-color-bg-page: rgb(248 250 252);    /* slate-50 */

    --aw-color-bg-page-dark: rgb(15 23 42);

    ::selection {
      background-color: rgb(217 119 6 / 25%);
    }
  }

  .dark {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: rgb(248 250 252);    /* slate-50 (inverted) */
    --aw-color-secondary: rgb(148 163 184);  /* slate-400 */
    --aw-color-accent: rgb(245 158 11);      /* amber-500 (brighter for dark) */

    --aw-color-text-heading: rgb(248 250 252);
    --aw-color-text-default: rgb(226 232 240);  /* slate-200 */
    --aw-color-text-muted: rgb(148 163 184);    /* slate-400 */
    --aw-color-bg-page: rgb(15 23 42);            /* slate-900 */

    ::selection {
      background-color: rgb(245 158 11 / 25%);
      color: rgb(15 23 42);
    }
  }
</style>
